# Backend API base URL for Axios.
# Dev (recommended): use Vite proxy and set `/api`
VITE_API_URL=/api

# Vite dev-server proxy target for `/api`.
# Example: http://localhost:5000
VITE_API_PROXY_TARGET=

# Firebase Web SDK config (safe to expose to the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional (only if you enable Google Analytics in Firebase)
VITE_FIREBASE_MEASUREMENT_ID=
